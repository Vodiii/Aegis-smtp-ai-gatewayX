# Ключ DeepSeek: не сохраняйте реальное значение в системе контроля версий.
DEEPSEEK_API_KEY_PRIMARY=
DEEPSEEK_MODEL=deepseek-flash

GATEWAY_MODE=ENFORCE
DEEPSEEK_API_TIMEOUT_SECONDS=8
DEEPSEEK_MAX_RETRIES=1
DEEPSEEK_RETRY_BACKOFF_SECONDS=0.35
SMTP_TIMEOUT_SECONDS=8
MAX_AI_TEXT_CHARS=6000
MAX_MESSAGE_SIZE_BYTES=10485760
MAX_RECIPIENTS=50
MAX_ATTACHMENTS=20
ALLOWED_RECIPIENT_DOMAINS=local.test
GATEWAY_LOOP_TOKEN=replace-with-a-random-secret

THRESHOLD_TERRORISM=0.70
THRESHOLD_TECHNOGENIC=0.60
THRESHOLD_ILLEGAL=0.80
THRESHOLD_OTHER_THREAT=0.75

DESTINATION_TERRORISM=alerts-terrorism@local.test
DESTINATION_TECHNOGENIC=alerts-technogenic@local.test
DESTINATION_ILLEGAL=alerts-illegal@local.test
DESTINATION_OTHER_THREAT=alerts-other@local.test
QUEUE_POLL_INTERVAL_SECONDS=0.25
# Сколько заданий максимум собирать перед одной итерацией обработки.
QUEUE_BATCH_MAX_MESSAGES=20
# Максимальное ожидание пополнения неполного пакета после первого письма.
QUEUE_BATCH_WAIT_SECONDS=0.25
# Сколько писем отправлять в одном основном запросе классификации DeepSeek.
DEEPSEEK_BATCH_SIZE=10
# Максимум писем в пакете повторной проверки тем же ключом.
DEEPSEEK_REVIEW_BATCH_SIZE=10
# Сколько ждать другие спорные результаты для общего пакета второго этапа.
DEEPSEEK_REVIEW_BATCH_WAIT_SECONDS=0.10
# Число фоновых потоков; параллельная обработка помогает собирать общий пакет повторной проверки.
QUEUE_WORKER_COUNT=2
QUEUE_RETRY_BASE_SECONDS=1
QUEUE_RETRY_MAX_SECONDS=60
QUEUE_STALE_SECONDS=120
DELIVERY_RETRY_BASE_SECONDS=2
DELIVERY_MAX_ATTEMPTS=8
QUEUE_MAX_ATTEMPTS=20
